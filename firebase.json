{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".cache",
        ".cache/**",
        "**/.cache/**",
        "paddleocr",
        "paddleocr/**",
        "*.local"
      ]
    },
    {
      "source": "functions/paddleocr",
      "codebase": "paddleocr",
      "runtime": "python312",
      "ignore": [
        "venv",
        "venv/**",
        ".venv",
        ".venv/**",
        "__pycache__",
        "**/__pycache__/**",
        "*.pyc",
        "tests",
        "tests/**",
        ".cache",
        "**/.cache/**",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "python3 \"$RESOURCE_DIR/scripts/prepare_models.py\" --verify"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/student-topic-practice-reset",
        "function": {"functionId": "studentTopicPracticeReset", "region": "us-central1"}
      },
      {
        "source": "/api/generateDeepseekText",
        "function": {
          "functionId": "generateDeepseekText",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
