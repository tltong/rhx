# Public website origins allowed to call the DeepSeek, image-generation, and OCR HTTP functions.
ALLOWED_WEB_ORIGINS=https://rhx-staging.web.app,https://rhx-staging.firebaseapp.com

# Set PADDLEOCR_URL to staging's private PaddleOCR service URL after deploying it.
# There is no production fallback when this setting is absent.

# Provision this staging bucket before deploying its OCR worker.
IMAGE_OCR_JOBS_BUCKET=rhx-staging-ocr-jobs
