rules_version = '2';
// Billing/access overlay on the live rules read 2026-10-31. Not yet deployed.
service cloud.firestore {
  match /databases/{database}/documents {
// Merge into the existing database match. This is not a replacement ruleset.
function cancelledSubscriptionAccessAllows(billing, cancellation) {
  let paidUntil = billing.get('activeUntil', null);
  let retainedUntil = cancellation.get('accessUntil', null);
  return (paidUntil is timestamp && request.time < paidUntil)
    || (retainedUntil is timestamp && request.time < retainedUntil);
}
function studentBillingDocumentAllows(studentId) {
  let billing = get(/databases/$(database)/documents/subscriptions/$(studentId)).data;
  let recovery = billing.get('renewalRecovery', null);
  let summary = billing.get('billingSummary', null);
  let context = summary is map && summary.get('paymentProvider', null) == 'stripe' ? summary : billing;
  let recovering = recovery is map
    && recovery.get('paymentProvider', null) == context.get('paymentProvider', null)
    && recovery.get('paymentMode', null) == context.get('paymentMode', null)
    && recovery.get('paymentSubscriptionReference', null) == context.get('paymentSubscriptionReference', null)
    && recovery.get('state', 'completed') != 'completed';
  let cancellation = billing.get('subscriptionCancellation', null);
  let cancelled = cancellation is map && cancellation.get('state', '') == 'cancelled'
    && cancellation.get('paymentMode', null) == context.get('paymentMode', null)
    && cancellation.get('paymentSubscriptionReference', null) == context.get('paymentSubscriptionReference', null);
  let paidUntil = billing.get('activeUntil', null);
  let pendingGrace = billing.get('renewalGraceUntil', null) is timestamp
    ? billing.renewalGraceUntil : paidUntil is timestamp ? paidUntil + duration.value(72, 'h') : request.time;
  let ended = summary is map && summary.get('subscriptionStatus', '') in ['canceled', 'incomplete_expired'];
  return billing.get('applicationStatus', 'active') != 'suspended'
    && (cancelled ? cancelledSubscriptionAccessAllows(billing, cancellation) : recovering
      ? recovery.get('graceUntil', null) is timestamp && request.time < recovery.graceUntil
      : billing.get('paymentProvider', null) != 'stripe'
        || (paidUntil is timestamp && (request.time < paidUntil || (!ended && request.time < pendingGrace))));
}
function studentHasBillingAccess(studentId) {
  return !exists(/databases/$(database)/documents/subscriptions/$(studentId))
    || studentBillingDocumentAllows(studentId);
}
function currentStudentHasBillingAccess() {
  return request.auth != null && studentHasBillingAccess(request.auth.uid);
}
function clientPreservesBillingState() {
  return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
    'subscriptionType', 'activeUntil', 'applicationStatus', 'paymentProvider', 'paymentMode',
    'paymentCustomerReference', 'paymentSubscriptionReference', 'planId', 'billingSummary', 'renewalRecovery', 'renewalGraceUntil', 'subscriptionCancellation'
  ]);
}

    function essayPoolReady() {
      return !exists(/databases/$(database)/documents/essayConfig/poolMaintenance)
        || get(/databases/$(database)/documents/essayConfig/poolMaintenance).data.get('active', false) != true;
    }
    function essayAssignmentAvailable(collection) {
      return collection != 'studentEssayPractices' || request.method == 'delete'
        || !request.resource.data.keys().hasAny(['essayQuestionId'])
        || request.resource.data.keys().hasAny(['completedAt'])
        || (exists(/databases/$(database)/documents/essayQuestionGenerator/questionIndex/entries/$(request.resource.data.essayQuestionId))
          && !exists(/databases/$(database)/documents/essayQuestionRetirements/$(request.resource.data.essayQuestionId)));
    }
    function signedIn() { return request.auth != null; }
    function siteAdmin() {
      return signedIn() && request.auth.token.get('email_verified', false)
        && request.auth.token.get('email', '') is string
        && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.token.email.lower()));
    }
    function guardianOf(studentId) {
      let linkId = request.auth.uid + '__' + studentId;
      return exists(/databases/$(database)/documents/guardianStudentLinks/$(linkId))
        && get(/databases/$(database)/documents/guardianStudentLinks/$(linkId)).data.get('state', '') == 'active';
    }
    function mayReadStudent(studentId) {
      return signedIn() && (request.auth.uid == studentId || siteAdmin() || guardianOf(studentId));
    }
    function mayWriteStudent(studentId) {
      return signedIn() && (request.auth.uid == studentId || siteAdmin());
    }
    function studentLearningCollection(collection) {
      return collection in ['studentPractices', 'studentEssayPractices', 'studentAssessmentProgress',
        'studentReadiness', 'studentDailyMissions', 'userCompletedQuestions', 'rewards'];
    }
    function sharedLearningCollection(collection) {
      return collection in ['questions', 'practices', 'essayPractices', 'essayResults'];
    }
    function fillInTheBlanksStudentCollection(collection) {
      return collection in ['studentFillInTheBlanksPractices', 'studentFillInTheBlanksPracticeGenerations', 'userUsedFillInTheBlanksPassages'];
    }
    function protectedCollection(collection) {
      return studentLearningCollection(collection) || sharedLearningCollection(collection) || fillInTheBlanksStudentCollection(collection)
        || collection in ['fillInTheBlanksQuestions', 'fillInTheBlanksPractices', 'fillInTheBlanksPracticeResults', 'fillInTheBlanksQuestionGenerator', 'fillInTheBlanksScoring', 'fillInTheBlanksDrafts', 'fillInTheBlanksPassageAssets']
        || collection in ['subscriptions', 'syllabusSubscriptions', 'stripeCustomers', 'paymentConfigs', 'siteAdmins', 'practiceResults', 'essayQuestionGenerator', 'essayQuestionAssets', 'essayQuestionSnapshots', 'essayQuestionRetirements', 'essayTypes', 'essayGradeConfigs', 'essayConfig', 'subjectAssessmentConfigs', 'subjectAssessments', 'subjectAssessmentGenerations', 'studentSubjectAssessmentUsage', 'subjectAssessmentSubmissions', 'subjectAssessmentResults', 'subjectAssessmentSettings', 'schoolStates', 'schoolLocalities', 'schools', 'students', 'studentUsernames', 'studentCredentialChanges', 'streamSubscriptions', 'guardianStudentLinks'];
    }
    // Profile and credential mutations are owned by studentProfile. Guardian reads
    // use its redacted response, including while legacy PIN fields are being removed.
    match /students/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || siteAdmin());
      allow write: if false;
    }
    match /studentUsernames/{document=**} { allow read, write: if false; }
    match /studentCredentialChanges/{document=**} { allow read, write: if false; }
    match /guardianStudentLinks/{linkId} {
      allow read: if signedIn() && (resource.data.guardianId == request.auth.uid || resource.data.studentId == request.auth.uid || siteAdmin());
      allow write: if false;
    }
    function studentStreamAllows(studentId, streamId) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      let stream = get(/databases/$(database)/documents/streams/$(streamId)).data;
      let schoolId = student.get('schoolId', null);
      return stream.country == student.country && stream.level == student.level
        && (schoolId == null || get(/databases/$(database)/documents/schools/$(schoolId)).data.streamId == streamId);
    }
    match /streamSubscriptions/{studentId} {
      allow read: if mayReadStudent(studentId);
      allow create, update: if signedIn() && (mayWriteStudent(studentId) || guardianOf(studentId))
        && request.resource.data.keys().hasOnly(['streamId'])
        && request.resource.data.streamId is string
        && studentStreamAllows(studentId, request.resource.data.streamId);
      allow delete: if mayWriteStudent(studentId)
        && get(/databases/$(database)/documents/students/$(studentId)).data.get('schoolId', null) == null;
    }
    function schoolSyllabusAllows(studentId, syllabusId, data) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      let schoolId = student.get('schoolId', null);
      return schoolId == null || data.get('state', '') != 'active'
        || schoolSyllabusAssignmentAllows(studentId, syllabusId, data, student, schoolId);
    }
    function schoolSyllabusAssignmentAllows(studentId, syllabusId, data, student, schoolId) {
      let streamId = get(/databases/$(database)/documents/schools/$(schoolId)).data.streamId;
      let baseYear = student.get('academicReferenceYear', student.yearOfRegistration);
      let baseGrade = student.get('gradeAtReferenceYear', int(student.standardAtYearOfRegistration));
      let grade = string(baseGrade + request.time.year() - baseYear);
      let assignments = get(/databases/$(database)/documents/streams/$(streamId)/years/$(grade)).data.get('syllabuses', {});
      return studentStreamAllows(studentId, streamId) && assignments.get(syllabusId, null) is map
        && assignments[syllabusId].language == data.language;
    }
    // Directory access is owned by the authenticated schoolCatalog backend.
    match /schoolStates/{document=**} { allow read, write: if false; }
    match /schoolLocalities/{document=**} { allow read, write: if false; }
    match /schools/{document=**} { allow read, write: if false; }
    function manualBilling(data) {
      return data.get('paymentProvider', null) == null
        && data.get('paymentSubscriptionReference', null) == null
        && data.get('paymentCustomerReference', null) == null
        && data.get('paymentMode', null) == null && data.get('planId', null) == null
        && data.get('billingSummary', null) == null && data.get('renewalRecovery', null) == null
        && data.get('renewalGraceUntil', null) == null && data.get('subscriptionCancellation', null) == null;
    }

    function syllabusCleanupAllows(studentId, syllabusId) {
      let path = /databases/$(database)/documents/subjectAssessmentGenerations/_students/students/$(studentId)/subjects/$(syllabusId);
      return !exists(path) || !(get(path).data.get('cleanup', {}).get('status', '') in ['pending', 'running']);
    }
    match /syllabusSubscriptions/{studentId} {
      allow read: if mayReadStudent(studentId);
      allow create, update: if signedIn() && (mayWriteStudent(studentId) || guardianOf(studentId));
      // Unsubscription and empty-parent deletion belong to the backend operation.
      allow delete: if false;
      match /syllabuses/{syllabusId} {
        allow read: if mayReadStudent(studentId);
        allow create, update: if signedIn() && (mayWriteStudent(studentId) || guardianOf(studentId))
          && syllabusCleanupAllows(studentId, syllabusId)
          && schoolSyllabusAllows(studentId, syllabusId, request.resource.data);
        allow delete: if false;
      }
    }

    // Billing authority is server-only. Client-created student trials remain supported.
    match /subscriptions/{studentId} {
      allow read: if mayReadStudent(studentId);
      allow create: if mayWriteStudent(studentId) && manualBilling(request.resource.data)
        && request.resource.data.get('applicationStatus', 'active') == 'active'
        && (siteAdmin() || request.resource.data.get('subscriptionType', '') == 'trial');
      allow update: if mayWriteStudent(studentId) && (clientPreservesBillingState()
        || (siteAdmin() && manualBilling(resource.data) && manualBilling(request.resource.data)));
      allow delete: if siteAdmin() && manualBilling(resource.data);
      match /{collection}/{document=**} {
        allow read: if !(collection in ['checkouts', 'renewalEpisodes', 'subscriptionCancellations', 'paymentViews']) && mayReadStudent(studentId);
        allow write: if collection == 'payments' && siteAdmin()
          && request.resource.data.get('paymentProvider', null) == null
          && get(/databases/$(database)/documents/subscriptions/$(studentId)).data.get('paymentProvider', null) == null;
      }
    }
    match /stripeCustomers/{document=**} {
      allow read: if siteAdmin();
      // Registration, payment methods and SetupIntent progress use backend APIs.
      allow write: if false;
    }
    match /paymentConfigs/{document} {
      allow read: if signedIn();
      allow write: if siteAdmin();
    }
    // The repeat policy is one global setting, independent of syllabus/language allocations.
    match /subjectAssessmentSettings/config {
      function validSettings() {
        let data = request.resource.data;
        return data.keys().hasOnly(['repeatMode', 'intervalDays', 'version', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && ((data.get('repeatMode', 'interval') == 'none' && data.get('intervalDays', null) == null)
            || (data.get('repeatMode', 'interval') == 'interval'
              && data.intervalDays is int && data.intervalDays > 0 && data.intervalDays <= 9007199254740991))
          && data.version is int && data.version > 0 && data.version <= 9007199254740991
          && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
      }
      allow read: if siteAdmin();
      allow create: if siteAdmin() && validSettings() && request.resource.data.version == 1
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if siteAdmin() && validSettings() && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    }
    // One standalone assessment configuration per syllabus/language, managed by admins.
    match /subjectAssessmentConfigs/{syllabusId}/languages/{languageKey} {
      function validConfiguration() {
        let data = request.resource.data;
        return data.keys().hasOnly(['syllabusId', 'language', 'languageKey', 'topics', 'version', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && data.syllabusId == syllabusId && data.languageKey == languageKey
          && data.language is string && data.language.size() > 0
          && data.language in get(/databases/$(database)/documents/syllabuses/$(syllabusId)).data.languages
          && data.topics is list && data.topics.size() > 0
          && data.version is int && data.version > 0
          && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
      }
      allow read: if siteAdmin();
      allow create: if siteAdmin() && validConfiguration()
        && request.resource.data.version == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if siteAdmin() && validConfiguration()
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Standalone assessments are server-published; students read frozen public items only.
    match /subjectAssessments/{assessmentId} {
      allow read: if currentStudentHasBillingAccess() && mayReadStudent(resource.data.studentId);
      allow write: if false;
      match /items/{itemId} {
        allow read: if currentStudentHasBillingAccess() && mayReadStudent(get(/databases/$(database)/documents/subjectAssessments/$(assessmentId)).data.studentId);
        allow write: if false;
      }
      match /private/{itemId} { allow read: if siteAdmin(); allow write: if false; }
    }
    match /subjectAssessmentGenerations/{document=**} { allow read: if siteAdmin(); allow write: if false; }
    match /studentSubjectAssessmentUsage/{document=**} { allow read: if siteAdmin(); allow write: if false; }
    match /subjectAssessmentSubmissions/{assessmentId} {
      allow read: if mayReadStudent(resource.data.studentId) && (siteAdmin() || studentHasBillingAccess(resource.data.studentId));
      allow write: if false;
      match /items/{itemId} {
        allow read: if mayReadStudent(get(/databases/$(database)/documents/subjectAssessmentSubmissions/$(assessmentId)).data.studentId)
          && (siteAdmin() || studentHasBillingAccess(get(/databases/$(database)/documents/subjectAssessmentSubmissions/$(assessmentId)).data.studentId));
        allow write: if false;
      }
      match /private/{document=**} { allow read: if siteAdmin(); allow write: if false; }
    }
    match /subjectAssessmentResults/{assessmentId} {
      allow read: if mayReadStudent(resource.data.studentId) && (siteAdmin() || studentHasBillingAccess(resource.data.studentId));
      allow write: if false;
      match /items/{itemId} {
        allow read: if exists(/databases/$(database)/documents/subjectAssessmentResults/$(assessmentId))
          && mayReadStudent(get(/databases/$(database)/documents/subjectAssessmentResults/$(assessmentId)).data.studentId)
          && (siteAdmin() || studentHasBillingAccess(get(/databases/$(database)/documents/subjectAssessmentResults/$(assessmentId)).data.studentId));
        allow write: if false;
      }
    }
    // Shared essay content is readable by signed-in users and immutable after creation.
    match /essayQuestionGenerator/config {
      allow read: if signedIn();
      allow create, update: if siteAdmin();
    }
    match /essayQuestionGenerator/questionIndex/entries/{questionId} {
      allow read: if signedIn();
      allow create: if siteAdmin() && essayPoolReady()
        && !exists(/databases/$(database)/documents/essayQuestionRetirements/$(questionId));
    }
    match /essayQuestionGenerator/{level}/standards/{standard}/languages/{language}/questions/{questionId} {
      allow read: if signedIn();
      allow create: if siteAdmin() && essayPoolReady()
        && !exists(/databases/$(database)/documents/essayQuestionRetirements/$(questionId));
    }
    match /essayTypes/{id} { allow read: if signedIn(); allow write: if false; }
    match /essayGradeConfigs/{id} { allow read: if signedIn(); allow write: if false; }
    match /essayConfig/{id} { allow read: if signedIn(); allow write: if false; }
    match /essayQuestionRetirements/{questionId} { allow read: if signedIn(); allow write: if false; }
    match /essayQuestionSnapshots/{questionId} { allow read: if signedIn(); allow write: if false; }
    match /essayQuestionAssets/{questionId} {
      // Paid generation progress and verified image metadata are server-owned.
      allow read, write: if false;
    }
    // Administrators manage reusable content; student scores and transitions are server-owned.
    match /fillInTheBlanksQuestions/{syllabusId}/topics/{topicId}/languages/{language}/passages/{passageId} {
      allow read: if currentStudentHasBillingAccess();
      allow create: if siteAdmin();
      match /questionItems/{questionId} { allow read: if currentStudentHasBillingAccess(); allow create: if siteAdmin(); }
      match /private/{document} { allow read: if siteAdmin(); allow create: if siteAdmin() && document == 'answerKey'; }
    }
    match /{path=**}/passages/{passageId} {
      allow list: if siteAdmin() && resource.data.get('format', '') == 'fillInTheBlanks';
    }
    match /fillInTheBlanksPractices/{practiceId} { allow read: if currentStudentHasBillingAccess(); allow create: if siteAdmin(); }
    match /fillInTheBlanksPracticeResults/{practiceId}/studentSubmissions/{studentId} {
      allow read: if currentStudentHasBillingAccess() && mayReadStudent(studentId); allow write: if false;
    }
    match /fillInTheBlanksQuestionGenerator/{document=**} { allow read: if signedIn(); }
    match /fillInTheBlanksQuestionGenerator/config { allow create, update: if siteAdmin(); }
    match /fillInTheBlanksQuestionGenerator/passageIndex/entries/{passageId} { allow create: if siteAdmin(); }
    match /fillInTheBlanksScoring/config { allow read: if signedIn(); allow create, update: if siteAdmin(); }
    match /fillInTheBlanksDrafts/{passageId} { allow read, create, update: if siteAdmin(); }
    match /fillInTheBlanksPassageAssets/{document=**} { allow read, write: if false; }
    match /studentFillInTheBlanksPractices/{studentId}/submissions/{practiceId} {
      allow create: if currentStudentHasBillingAccess() && mayWriteStudent(studentId)
        && exists(/databases/$(database)/documents/studentFillInTheBlanksPractices/$(studentId)/assignedPractices/$(practiceId))
        && request.resource.data.keys().hasOnly(['answers', 'timeTakenSeconds', 'submittedAt', 'markingStatus', 'requestId', 'requestedAt'])
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 100
        && request.resource.data.timeTakenSeconds is number && request.resource.data.timeTakenSeconds >= 0
        && request.resource.data.markingStatus == 'submitted'
        && request.resource.data.submittedAt == request.time && request.resource.data.requestedAt == request.time
        && request.resource.data.requestId is string && request.resource.data.requestId.size() > 0 && request.resource.data.requestId.size() <= 128;
      allow update: if currentStudentHasBillingAccess() && mayWriteStudent(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestId', 'requestedAt'])
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestId is string && request.resource.data.requestId.size() > 0 && request.resource.data.requestId.size() <= 128
        && request.resource.data.requestId != resource.data.get('requestId', '');
    }
    match /{collection}/{studentId}/{document=**} {
      allow read: if fillInTheBlanksStudentCollection(collection) && currentStudentHasBillingAccess() && mayReadStudent(studentId);
      allow write: if false;
    }
    match /siteAdmins/{document} {
      allow read: if signedIn();
      // The existing authenticated admin callables own membership/bootstrap.
      allow write: if false;
    }
    match /{collection}/{studentId}/{document=**} {
      allow read: if studentLearningCollection(collection) && currentStudentHasBillingAccess()
        && (mayReadStudent(studentId) || studentId == 'config');
      allow write: if studentLearningCollection(collection) && currentStudentHasBillingAccess()
        && (collection != 'studentEssayPractices' || essayPoolReady()) && essayAssignmentAvailable(collection)
        && (studentId == 'config' ? siteAdmin() : mayWriteStudent(studentId));
    }
    match /{collection}/{document=**} {
      allow read, write: if sharedLearningCollection(collection) && currentStudentHasBillingAccess();
    }
    match /practiceResults/{practiceId} {
      allow read, write: if currentStudentHasBillingAccess();
      match /studentSubmissions/{studentId} {
        allow read: if currentStudentHasBillingAccess() && mayReadStudent(studentId);
        allow write: if currentStudentHasBillingAccess() && mayWriteStudent(studentId);
      }
    }
    // Preserve the existing policy outside this billing/learning change. This
    // deliberately excludes all guarded roots: Firestore allow rules combine by OR.
    match /{collection}/{document=**} {
      allow read, write: if !protectedCollection(collection);
    }

  }
}
